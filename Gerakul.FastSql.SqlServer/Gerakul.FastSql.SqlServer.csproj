    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gerakul.FastSql.Common\Gerakul.FastSql.Common.csproj" />
  </ItemGroup>

</Project>
