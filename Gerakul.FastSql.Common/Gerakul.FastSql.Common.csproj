<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard1.3;netstandard2.0;net46</TargetFrameworks>
    <Version>1.1.0</Version>
    <Description>Core functionality of FastSql: Light-weight, flexible and easy to use C# library to retrieve and manipulate (including bulk copy) data in SQL databases.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Interactive.Async" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard1.3' ">
    <PackageReference Include="System.Reflection.TypeExtensions" />
    <PackageReference Include="System.Data.Common" />
  </ItemGroup>

</Project>
